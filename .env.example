# ---------- backend (Render) ----------
SEC_USER_AGENT="CallWatch KAIST-DFMBA your.name@example.com"
LLM_PROVIDER=gemini            # gemini | groq | openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENAI_API_KEY=

# Toss Securities Open API - WTS > 설정 > Open API 에서 발급, 서버 공인 IP를 허용 IP에 등록
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=              # optional; default = first BROKERAGE account
OWNER_KEY=                     # operator key (X-Owner-Key): Toss sync + no limits. Required when TOSS_* is set

# Open access (default): featured stocks are public; visitors keep holdings per browser
FEATURED_TICKERS=AAPL,MSFT,NVDA,GOOGL,TSLA,SPCX,C,LLY
WARM_FEATURED=1                # analyse featured stocks in the background (live mode)
ANON_DAILY_ANALYSIS_LIMIT=3    # new tickers per browser/IP per day
QA_DAILY_LIMIT=20              # AI questions per browser per day

# Optional sign-in (Supabase Auth). Set SUPABASE_URL to turn on accounts.
SUPABASE_URL=                  # https://<project>.supabase.co  (JWTs verified via its JWKS)
SUPABASE_ANON_KEY=             # publishable key (sb_publishable_...); verifies logins via /auth/v1/user if needed
SUPABASE_JWT_SECRET=           # optional, legacy HS256 secret (faster local verification)
SUPABASE_SERVICE_ROLE_KEY=     # optional: lets "내 데이터 삭제" also delete the login account
OWNER_EMAILS=                  # comma-separated; only these accounts can use the server's Toss connection
DAILY_ANALYSIS_LIMIT=30        # live analyses per user per day (owners unlimited)

API_NINJAS_KEY=                # optional transcript source
DEMO_MODE=0                    # 1 = fictional companies + fictional Toss account, no network
DATABASE_URL=                  # empty = SQLite ; postgresql://... for Supabase
CORS_ORIGINS=*                 # production: https://<your-app>.vercel.app

# ---------- web (Vercel) : web/.env ----------
# VITE_API_URL=https://<your-api>.onrender.com
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<publishable / anon key>
